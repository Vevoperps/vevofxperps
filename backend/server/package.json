{
  "name": "vevo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/index.js",
    "dev": "node --env-file=.env --no-experimental-strip-types --import tsx src/index.ts",
    "test": "node --no-experimental-strip-types --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.2",
    "bs58": "^6.0.0",
    "pg": "^8.13.1",
    "tweetnacl": "^1.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
