# Copy to `.env` for local runs. On Railway set these as service variables.
# Never commit `.env` or any key.

# --- storage -------------------------------------------------------------------
# Railway: reference the Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# true only for a public Postgres URL that requires TLS
DATABASE_SSL=

# --- chain ---------------------------------------------------------------------
# A provider URL (Helius, QuickNode...). The public endpoint rate-limits.
RPC_URL=
CLUSTER=mainnet
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# The hot wallet (JSON byte array or base58). A NEW wallet used for nothing
# else: it receives every deposit and signs every withdrawal. Fund it with
# ~0.05 SOL for fees.
TREASURY_KEY=

# --- withdrawals (whole USDC) --------------------------------------------------
WITHDRAW_MAX_SINGLE=2000
WITHDRAW_MAX_DAILY=10000
MIN_TRANSFER=1

# --- access --------------------------------------------------------------------
# 32+ random characters each (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
ADMIN_TOKEN=
ALLOWED_ORIGINS=https://vevoperps.com,https://www.vevoperps.com,http://localhost:3000
SIGNIN_DOMAIN=vevoperps.com

# --- prices --------------------------------------------------------------------
FX_URL=https://api.fxratesapi.com/latest
PRICE_INTERVAL=15
MARK_MAX_AGE=120
MAX_DEVIATION_BPS=500
LIQUIDATION_INTERVAL=5

# Liquidation reward: blank keeps it in the pool (for LPs); or a wallet address.
HOUSE_ADDRESS=
