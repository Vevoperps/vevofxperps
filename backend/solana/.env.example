# Copy to `.env`. Never commit `.env` or any keypair file.

# --- cluster -------------------------------------------------------------------
# devnet first:  https://api.devnet.solana.com
# mainnet:       your provider's URL (Helius, Triton, ...). The public mainnet
#                endpoint rate-limits hard and refuses the account scans the
#                keeper needs.
RPC_URL=https://api.devnet.solana.com

# The admin wallet: lists markets, sets parameters, names the publisher.
# Keep it off servers. Default: ~/.config/solana/id.json
ADMIN_KEYPAIR=

# --- settlement ----------------------------------------------------------------
# mainnet USDC: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# devnet USDC (Circle's faucet mint): 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_MINT=

# --- oracle --------------------------------------------------------------------
# The keeper's PUBLIC key. A separate wallet holding only SOL for fees.
PUBLISHER=
ORACLE_MAX_AGE=900
ORACLE_MAX_DEVIATION_BPS=500

# --- pool ----------------------------------------------------------------------
POOL_LIQUIDITY=
