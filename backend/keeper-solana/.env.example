# Copy to `.env` and fill in. Never commit `.env`.

# --- cluster -------------------------------------------------------------------
# devnet: https://api.devnet.solana.com
# mainnet: a provider URL (Helius, Triton, ...). The public mainnet endpoint
# refuses the getProgramAccounts scans the liquidator and price loop make.
RPC_URL=https://api.devnet.solana.com

# The deployed program's address (Anchor.toml / `anchor keys list`).
PROGRAM_ID=

# The publisher's secret key: JSON byte array or base58. A throwaway wallet
# funded with ~0.1 SOL for fees and nothing else — never the admin or deployer.
# It must be the key named as PUBLISHER when the program was initialised.
KEEPER_KEY=

# --- prices --------------------------------------------------------------------
FX_URL=https://api.fxratesapi.com/latest
MIN_MOVE_BPS=2
ALWAYS_FRESH=USDJPY,USDEUR,USDGBP
POST_CHUNK=40
# micro-lamports per compute unit
PRIORITY_FEE=20000

# --- cadence, in seconds -------------------------------------------------------
PRICE_INTERVAL=15
LIQUIDATION_INTERVAL=20
SNAPSHOT_INTERVAL=1200

# --- warm endpoint (shared with the site's /api/warm) --------------------------
WARM_SECRET=
WARM_TTL=600
