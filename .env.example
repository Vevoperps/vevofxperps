# Copy to `.env` and fill in. Never commit `.env`.

# Public origin, no trailing slash. Leave blank locally — the code falls back
# to the canonical domain in `src/lib/brand.ts`.
NEXT_PUBLIC_SITE_URL=

# Optional upstream the contact endpoint forwards leads to (CRM / webhook).
CONTACT_ENDPOINT=

# Pre-launch gate: the code visitors must enter before any page renders.
#
# There is no default. Leave this blank and the gate is simply OFF — which is
# what a fresh clone wants, and what production must not have. Set it in the
# Vercel project's environment variables before the first deploy. Changing it
# invalidates every cookie already issued, which is also how you revoke access.
SITE_PASSWORD=

# --- the venue, when it exists -----------------------------------------------
# With these set, every app screen reads the Solana program: marks, funding,
# open interest, balances and positions. Leave them blank and the app is the
# read-only preview, which is what every screen then says.
#
# NEXT_PUBLIC_ because a program address is public the moment it is deployed.
# Nothing secret goes here: the app holds no key and signs nothing itself.
#
# mainnet | devnet | localnet
NEXT_PUBLIC_CLUSTER=devnet
# The program id (backend/solana: `anchor keys list`).
NEXT_PUBLIC_PROGRAM_ID=
# mainnet USDC: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# devnet USDC:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_USDC_MINT=
# Used by the browser for a blockhash and to confirm a signed transaction.
# Use a provider URL restricted to your domain, not a secret one.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Optional, server only: a keyed RPC for the /api reads. Falls back to the
# public one above.
SOLANA_RPC_URL=

# --- the $VEVO page lock -------------------------------------------------------
# /app/vevo is closed for maintenance until the launch patch fills in the
# token's contract and links. Its code defaults to SITE_PASSWORD; set this to
# give it its own. Set TOKEN_PAGE_LOCK=off to reopen the page for everyone.
TOKEN_PAGE_PASSWORD=
TOKEN_PAGE_LOCK=
