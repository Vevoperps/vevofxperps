# Copy to `.env` and fill in. Never commit `.env`.

# Public origin, no trailing slash. Leave blank locally — the code falls back
# to the canonical domain in `src/lib/brand.ts`.
NEXT_PUBLIC_SITE_URL=

# Optional upstream the contact endpoint forwards leads to (CRM / webhook).
CONTACT_ENDPOINT=

# Pre-launch gate: the code visitors must enter before any page renders.
#
# There is no default. Leave this blank and the gate is simply OFF — which is
# what a fresh clone wants, and what production must not have. Set it in the
# Vercel project's environment variables before the first deploy. Changing it
# invalidates every cookie already issued, which is also how you revoke access.
SITE_PASSWORD=

# --- the venue, when it exists -----------------------------------------------
# With these four set, every app screen reads the engine: marks, funding, open
# interest, balances and positions. Leave them blank and the app is the
# read-only preview, which is what every screen then says.
#
# They are NEXT_PUBLIC_ because a contract address is public the moment it is
# deployed and the wallet needs the chain's details to add it. Nothing secret
# ever goes here: the app has no server key and signs nothing itself. All
# reading still happens server-side, through /api/*.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_ENGINE_ADDRESS=
NEXT_PUBLIC_SETTLEMENT_ADDRESS=
# The block the engine was deployed at. Log queries for the history and
# transfers tabs start here; left at zero a public node usually refuses the
# range and those two tabs simply come back empty.
NEXT_PUBLIC_DEPLOY_BLOCK=0

# --- the $VEVO page lock -------------------------------------------------------
# /app/vevo is closed for maintenance until the launch patch fills in the
# token's contract and links. Its code defaults to SITE_PASSWORD; set this to
# give it its own. Set TOKEN_PAGE_LOCK=off to reopen the page for everyone.
TOKEN_PAGE_PASSWORD=
TOKEN_PAGE_LOCK=
